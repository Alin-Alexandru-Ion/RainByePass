{
  "name": "rainbyepass",
  "version": "0.5.4",
  "private": true,
  "license": "MIT",
  "description": "An offline-first, seasonal ambient virtual window.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "start:built": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "npm run build && electron . --smoke-test",
    "package": "npm run build && node scripts/package-offline-win.mjs",
    "package:electron-packager": "npm run build && electron-packager . RainByePass --out=releases --overwrite --asar --ignore=\"^/(src|tests|scripts|evidence|releases|\\.tmp|assets/source|assets/runtime|node_modules/(electron|typescript|tsx|esbuild|@electron))($|/)\"",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "suncalc": "2.1.1"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/packager": "20.3.0",
    "@types/node": "24.10.1",
    "electron": "44.7.2",
    "esbuild": "0.28.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "tsx": {
      "esbuild": "0.28.1"
    }
  }
}
